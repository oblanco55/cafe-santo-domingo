# Base de datos PostgreSQL (desarrollo local, ver docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/cafesantodomingo?schema=public"

# Auth.js — generarlo con: openssl rand -base64 32
AUTH_SECRET=

# Llave de cifrado de 32 bytes base64 (openssl rand -base64 32). Nunca se guarda en BD.
SETTINGS_ENCRYPTION_KEY=

# ADMIN_EMAILS: lista separada por comas de correos que reciben role=admin
ADMIN_EMAILS="resp5totech@gmail.com"

# Fecha de finalización de campaña (ISO 8601)
CAMPAIGN_END_DATE="2026-12-31T23:59:59"

# Proveedor de IA: "mock" (desarrollo gratuito/local), "fal" o "replicate"
AI_PROVIDER="mock"
FAL_KEY=
REPLICATE_API_TOKEN=

# Opcional si se usa Anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

